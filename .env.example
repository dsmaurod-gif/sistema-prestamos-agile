# Copia este archivo como ".env" y completa los valores.
# NUNCA subas el archivo ".env" a GitHub.
# Pide los valores al integrador (A) por un canal privado.
# Solo se usa la llave PÚBLICA (publishable o anon). Jamás la service_role.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu-llave-publica

# Si usas Vite (React/Vue), los nombres deben empezar con VITE_:
# VITE_SUPABASE_URL=...
# VITE_SUPABASE_PUBLISHABLE_KEY=...
